# Copy to .env and adjust if the port is busy.
PORT=4000

# Optional: comma-separated browser origins. Leave unset to allow any origin (dev / Postman).
# CORS_ORIGIN=http://localhost:5173,http://localhost:4000

# Firebase Admin (required for Firestore). Easiest: download the JSON key and put it in the project root, then:
# FIREBASE_SERVICE_ACCOUNT_PATH=./your-project-firebase-adminsdk-xxxxx.json
#
# Or use individual vars instead of a JSON file:
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
